# Copy to .env.production (gitignored) and fill in. Everything here is a
# public identifier or display value baked into the browser bundle; the
# real secrets (Stripe secret key, webhook signing secret) never go in an
# env file. They are set with `wrangler secret put` only.

# Firebase web app config: console.firebase.google.com -> Project settings
# -> General -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Display prices only; the charge is always the Stripe price, so keep the
# Stripe price equal to VITE_PRICE_DISPLAY. The currency is named in the
# sales page's small print, not on the figure, which keeps the price legible.
# ANCHOR is the list price the display price is cut from; use a price you
# genuinely intend to charge.
VITE_PRICE_DISPLAY=$57
VITE_PRICE_ANCHOR=$99
