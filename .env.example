# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Everything here has a working local default in docker-compose.yml, so
# `docker compose up` works with no .env at all. The values below matter from
# phase 1 (Firebase) and phase 6 (Neon/Upstash/GCP) onward.

# ── Local, already defaulted in compose ──────────────────────────────────────
LOG_LEVEL=info

# ── Firebase (phase 1) ───────────────────────────────────────────────────────
# Locally this stays as the demo project so the emulator refuses to reach
# production Google. The real id is only ever set in Cloud Run.
FIREBASE_PROJECT_ID=demo-deepcs

# Presence of this variable is what switches the Gateway into emulator mode.
# DESIGN.md §7: the emulator issues UNSIGNED tokens, so this flag must be
# impossible to set in production.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9099

# The web app config from the Firebase console (0-cloud-setup.md Part 7).
# Nothing reads these yet — no frontend exists — saved here for whenever one does.
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=

# ── Gateway (phase 1) ────────────────────────────────────────────────────────
# The single origin CORS is locked to (§6). Not '*': the frontend sends an
# Authorization header, and a wildcard origin cannot be used with credentialed
# requests at all — so '*' would be both less safe and non-functional.
CORS_ORIGIN=http://localhost:5173

# ── Managed data (phase 6 — from Neon and Upstash, Singapore region) ─────────
# One connection string PER SERVICE in production, each using that service's own
# Postgres role (ADR-09). A single shared URL would undo the schema boundary
# that packages/db/migrations/002_service_roles.sql exists to enforce.
# The hostname MUST contain `-pooler` — see 0-cloud-setup.md Part 8.
# DATABASE_URL=postgresql://users_svc:...@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# REDIS_URL=rediss://...upstash.io:6379

# ── GCP (phase 6) ────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=
# GCP_REGION=asia-southeast1
