# Copy to .env and fill in. .env is gitignored — never commit it.
#
# Everything here has a working local default in docker-compose.yml, so
# `docker compose up` works with no .env at all. The values below matter from
# phase 1 (Firebase) and phase 6 (Neon/Upstash/GCP) onward.

# ── Local, already defaulted in compose ──────────────────────────────────────
LOG_LEVEL=info

# ── Firebase (phase 1) ───────────────────────────────────────────────────────
# Locally this stays as the demo project so the emulator refuses to reach
# production Google. The real id is only ever set in Cloud Run.
FIREBASE_PROJECT_ID=demo-deepcs

# Presence of this variable is what switches the Gateway into emulator mode.
# DESIGN.md §7: the emulator issues UNSIGNED tokens, so this flag must be
# impossible to set in production.
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth:9099

# The web app config from the Firebase console (0-cloud-setup.md Part 7).
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=

# ── Frontend (phase 5) ───────────────────────────────────────────────────────
# Vite only exposes variables prefixed VITE_ to browser code, so the frontend
# needs its own copies of the Firebase values above rather than reading them.
# That prefix is a safety rail: it makes leaking a server-side secret into a
# bundle something you have to do on purpose.
#
# All of these ship inside the JavaScript and are public by design. A Firebase
# web API key identifies a project, it does not authorise anything — the
# Gateway still verifies every token's signature and audience before trusting
# a request.
#
# These live in frontend/.env.local (already gitignored by the .env.* rule),
# not here, because the frontend is not run by docker compose. Every value has
# a working local default in frontend/src/config.ts, so `pnpm --filter
# @deepcs/web dev` works against the emulator with no file at all.
#
# VITE_GATEWAY_URL=http://localhost:8080
#
# Presence of this switches the browser SDK to the Auth emulator, mirroring how
# FIREBASE_AUTH_EMULATOR_HOST works for the Gateway. Note localhost, not the
# compose service name: the browser resolves it from the host.
# VITE_FIREBASE_AUTH_EMULATOR=http://localhost:9099
#
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=demo-deepcs
# VITE_FIREBASE_APP_ID=

# ── Gateway (phase 1) ────────────────────────────────────────────────────────
# The single origin CORS is locked to (§6). Not '*': the frontend sends an
# Authorization header, and a wildcard origin cannot be used with credentialed
# requests at all — so '*' would be both less safe and non-functional.
CORS_ORIGIN=http://localhost:5173

# ── Managed data (phase 6 — from Neon and Upstash, Singapore region) ─────────
# One connection string PER SERVICE in production, each using that service's own
# Postgres role (ADR-09). A single shared URL would undo the schema boundary
# that packages/db/migrations/002_service_roles.sql exists to enforce.
# The hostname MUST contain `-pooler` — see 0-cloud-setup.md Part 8.
# DATABASE_URL=postgresql://users_svc:...@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# REDIS_URL=rediss://...upstash.io:6379

# ── GCP (phase 6) ────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=
# GCP_REGION=asia-southeast1
